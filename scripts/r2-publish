#!/usr/bin/env python3
"""Stage immutable Debian packages and publish signed APT indexes in R2.

Package build jobs call stage; the serialized index publisher calls index.
Pending upload manifests remain until InRelease has been published.
"""
import gzip
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import urllib.request

BUCKET = os.environ.get("R2_BUCKET", "mbligh-apt")
ENDPOINT = os.environ.get("R2_ENDPOINT") or (
    "https://" + os.environ.get("R2_ACCOUNT_ID", "") + ".r2.cloudflarestorage.com")
SOURCE = os.environ.get("APT_MIGRATION_URL", "https://apt.mbligh.org").rstrip("/")
DIST = Path("dist")
STATE = "publish-state.json"
INDEX = "dists/trixie/main/binary-amd64/Packages"


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def aws(*args, check=True, capture=False):
    return subprocess.run(["aws", "--endpoint-url", ENDPOINT, *args],
                          check=check, capture_output=capture, text=True)


def get(key, dest):
    dest = Path(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    result = aws("s3api", "get-object", "--bucket", BUCKET, "--key", key,
                 str(dest), check=False, capture=True)
    if result.returncode:
        if "NoSuchKey" in result.stderr or "404" in result.stderr or "Not Found" in result.stderr:
            return False
        raise RuntimeError(result.stderr)
    return True


def put(path, key, *, cache=None, immutable=False, metadata=None):
    cmd = ["s3api", "put-object", "--bucket", BUCKET, "--key", key,
           "--body", str(path)]
    if cache:
        cmd += ["--cache-control", cache]
    if immutable:
        cmd += ["--if-none-match", "*"]
    if metadata:
        for name, value in metadata.items():
            cmd += ["--metadata", name + "=" + value]
    result = aws(*cmd, check=False, capture=True)
    if result.returncode:
        if immutable and ("PreconditionFailed" in result.stderr or "412" in result.stderr):
            # Never overwrite existing immutable objects. Caller checks hashes
            # against the published index for packages.
            return False
        raise RuntimeError(result.stderr)
    return True


def digest(path):
    h = hashlib.sha256()
    with open(path, "rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def read_state():
    with tempfile.TemporaryDirectory() as d:
        p = Path(d) / "state.json"
        if not get(STATE, p):
            return None
        return json.loads(p.read_text())


def stanzas(contents):
    for item in contents.decode().split("\n\n"):
        item = item.strip()
        # Drop empty optional control fields (e.g. "Provides:"). APT
        # rejects them even though dpkg-deb -f prints them.
        item = "\n".join(line for line in item.splitlines()
                         if not re.fullmatch(r"[A-Za-z][A-Za-z0-9-]*:\s*", line))
        if item:
            fields = {}
            for line in item.splitlines():
                if line and not line[0].isspace() and ": " in line:
                    k, v = line.split(": ", 1)
                    fields[k] = v
            if "Filename" in fields:
                yield fields, item


def download_source(path):
    local = os.environ.get("APT_MIGRATION_DIR")
    if local:
        return (Path(local) / path).read_bytes()
    with urllib.request.urlopen(SOURCE + "/" + path, timeout=120) as response:
        return response.read()


def bootstrap():
    if read_state() is not None:
        print("R2 publication already initialized; no migration needed")
        return
    # On the first publication migrate the current Pages archive, including
    # package versions no longer built by the current scripts.
    print("Migrating existing Pages archive from", SOURCE)
    data = gzip.decompress(download_source(INDEX + ".gz"))
    entries = list(stanzas(data))
    if not entries:
        raise RuntimeError("Source Pages repository has no package entries")
    DIST.mkdir(exist_ok=True)
    for fields, _ in entries:
        name = Path(fields["Filename"]).name
        dest = DIST / name
        if not dest.exists() or digest(dest) != fields["SHA256"]:
            dest.write_bytes(download_source(fields["Filename"]))
        if digest(dest) != fields["SHA256"]:
            raise RuntimeError("Bootstrap checksum mismatch: " + name)
    print("Verified", len(entries), "historical packages")


def deb_stanza(deb):
    metadata = run("dpkg-deb", "-f", str(deb), capture_output=True, text=True).stdout.strip()
    metadata = "\n".join(line for line in metadata.splitlines()
                         if not re.fullmatch(r"[A-Za-z][A-Za-z0-9-]*:\s*", line))
    filename = "pool/main/" + deb.name
    return {"Filename": filename, "SHA256": digest(deb)}, (
        metadata + "\nFilename: " + filename +
        "\nSize: " + str(deb.stat().st_size) +
        "\nSHA256: " + digest(deb))



def head(key):
    result = aws("s3api", "head-object", "--bucket", BUCKET, "--key", key,
                 check=False, capture=True)
    if result.returncode:
        if any(code in result.stderr for code in ("404", "Not Found", "NoSuchKey")):
            return None
        raise RuntimeError(result.stderr)
    return json.loads(result.stdout)


def verify_object(key, sha256, size):
    info = head(key)
    if info is None:
        return False
    if int(info["ContentLength"]) != size:
        raise RuntimeError("Existing R2 object has different size: " + key)
    recorded = info.get("Metadata", {}).get("sha256")
    if recorded:
        if recorded != sha256:
            raise RuntimeError("Version conflict: same R2 key, different SHA-256: " + key)
    else:
        # Old R2 objects lack SHA metadata; verify the bytes once.
        with tempfile.TemporaryDirectory() as tmp:
            existing = Path(tmp) / "object.deb"
            if not get(key, existing) or digest(existing) != sha256:
                raise RuntimeError("Version conflict: R2 object differs: " + key)
    return True


def load_index(temp):
    old_index = temp / "old-Packages"
    if get(INDEX, old_index):
        return {f["Filename"]: (f, e)
                for f, e in stanzas(old_index.read_bytes())}
    if read_state() is not None:
        raise RuntimeError("R2 manifest exists but Packages index is absent")
    return {}


def stage(run_id):
    """Upload package files in the individual package build job."""
    if not re.fullmatch(r"[0-9]+", run_id):
        raise ValueError("stage requires a numeric GitHub run ID")
    with tempfile.TemporaryDirectory() as tmp:
        temp = Path(tmp)
        old = load_index(temp)
        pending = []
        for deb in sorted(DIST.glob("*.deb")):
            fields, stanza = deb_stanza(deb)
            control = run("dpkg-deb", "-f", str(deb),
                          capture_output=True, text=True).stdout.splitlines()
            fields_by_name = {line.split(": ", 1)[0]: line.split(": ", 1)[1]
                              for line in control if line and not line[0].isspace()
                              and ": " in line}
            identity = [fields_by_name.get(k) for k in ("Package", "Version", "Architecture")]
            if not all(identity) or deb.name != "_".join(identity) + ".deb":
                raise RuntimeError("Debian control fields disagree with filename: " + deb.name)
            key, sha = fields["Filename"], fields["SHA256"]
            size = deb.stat().st_size
            if key in old:
                if old[key][0]["SHA256"] != sha:
                    raise RuntimeError("Version conflict: published .deb differs: " + key)
                print("Already indexed with identical SHA-256:", key)
                continue
            if not verify_object(key, sha, size):
                if not put(deb, key, immutable=True, metadata={"sha256": sha}):
                    # Someone else uploaded this version first.
                    if not verify_object(key, sha, size):
                        raise RuntimeError("R2 upload race: missing object: " + key)
                print("Uploaded or verified immutable object:", key)
            else:
                print("Recovering previously uploaded unindexed object:", key)
            if not verify_object(key, sha, size):
                raise RuntimeError("R2 upload verification failed: " + key)
            pending.append({"key": key, "sha256": sha, "size": size, "stanza": stanza})
        if not pending:
            print("No changed packages to publish")
            return
        marker = "pending/" + run_id + ".json"
        manifest = temp / "manifest.json"
        manifest.write_text(json.dumps({"version": 1, "run_id": run_id,
                                        "entries": pending}, sort_keys=True) + "\n")
        if not put(manifest, marker, immutable=True):
            existing = temp / "old-manifest.json"
            if not get(marker, existing) or json.loads(existing.read_text()) != json.loads(manifest.read_text()):
                raise RuntimeError("Conflicting pending manifest: " + marker)
        print("Staged", len(pending), "package(s) under", marker)


def pending_keys(run_id):
    if run_id:
        if not re.fullmatch(r"[0-9]+", run_id):
            raise ValueError("index requires numeric build run ID")
        return ["pending/" + run_id + ".json"]
    result = aws("s3api", "list-objects-v2", "--bucket", BUCKET,
                 "--prefix", "pending/", "--output", "json", capture=True)
    return sorted(x["Key"] for x in json.loads(result.stdout).get("Contents", [])
                  if re.fullmatch(r"pending/[0-9]+\.json", x["Key"]))


def retire_pending(keys):
    for key in keys:
        aws("s3api", "delete-object", "--bucket", BUCKET, "--key", key)


def index(run_id):
    """Only sign an index of already-uploaded R2 package objects."""
    with tempfile.TemporaryDirectory() as d:
        temp = Path(d)
        markers = []
        pending = []
        for marker in pending_keys(run_id):
            path = temp / ("manifest-" + str(len(markers)) + ".json")
            if not get(marker, path):
                if run_id:
                    print("No pending publication for run", run_id)
                    return
                continue
            data = json.loads(path.read_text())
            if (data.get("version") != 1 or
                    marker != "pending/" + str(data.get("run_id")) + ".json" or
                    not isinstance(data.get("entries"), list)):
                raise RuntimeError("Invalid pending manifest: " + marker)
            markers.append(marker)
            pending.extend(data["entries"])
        if not pending:
            print("No pending packages to index")
            retire_pending(markers)
            return

        entries = load_index(temp)
        added = 0
        for item in pending:
            key, sha, size, stanza = (
                item["key"], item["sha256"], item["size"], item["stanza"])
            if (not isinstance(key, str) or
                    not re.fullmatch(r"pool/main/[A-Za-z0-9][A-Za-z0-9+._:%~-]*\.deb", key) or
                    ".." in key or
                    not isinstance(sha, str) or not re.fullmatch(r"[0-9a-f]{64}", sha) or
                    not isinstance(size, int) or size <= 0):
                raise RuntimeError("Invalid pending package: " + str(key))
            decoded = list(stanzas((stanza + "\n\n").encode()))
            if len(decoded) != 1:
                raise RuntimeError("Invalid pending APT stanza: " + key)
            fields, entry = decoded[0]
            if (fields["Filename"] != key or fields.get("SHA256") != sha or
                    fields.get("Size") != str(size) or
                    any(not fields.get(f) for f in ("Package", "Version", "Architecture"))):
                raise RuntimeError("Pending package metadata mismatch: " + key)
            if not verify_object(key, sha, size):
                raise RuntimeError("Missing staged package in R2: " + key)
            if key in entries:
                if entries[key][0]["SHA256"] != sha:
                    raise RuntimeError("Indexed version has different SHA-256: " + key)
                print("Already indexed:", key)
                continue
            entries[key] = (fields, entry)
            added += 1
        if not entries:
            raise RuntimeError("Refusing to publish empty APT repository")
        if not added:
            print("All pending packages are already indexed")
            retire_pending(markers)
            return
        site = temp / "site"
        binary = site / "dists/trixie/main/binary-amd64"
        binary.mkdir(parents=True)
        index = binary / "Packages"
        index.write_text("".join(e + "\n\n" for _, e in (
            entries[key] for key in sorted(entries))))
        gz = binary / "Packages.gz"
        with gz.open("wb") as raw:
            with gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=0, compresslevel=9) as output:
                output.write(index.read_bytes())

        # Immutable indexes are uploaded before any mutable metadata.
        for path in (index, gz):
            key = ("dists/trixie/main/binary-amd64/by-hash/SHA256/" + digest(path))
            put(path, key, immutable=True, cache="public, max-age=31536000, immutable")

        config = temp / "release.conf"
        config.write_text(
            'APT::FTPArchive::Release::Origin "mbligh";\n'
            'APT::FTPArchive::Release::Label "mbligh";\n'
            'APT::FTPArchive::Release::Suite "trixie";\n'
            'APT::FTPArchive::Release::Codename "trixie";\n'
            'APT::FTPArchive::Release::Architectures "amd64";\n'
            'APT::FTPArchive::Release::Components "main";\n'
            'APT::FTPArchive::Release::Acquire-By-Hash "yes";\n')
        release_dir = site / "dists/trixie"
        release = release_dir / "Release"
        with release.open("w") as out:
            run("apt-ftparchive", "-c", str(config.resolve()), "release", "dists/trixie", cwd=site, stdout=out)
        # apt-ftparchive generates paths relative to cwd: run from site/ below if necessary.
        value = release.read_text()
        value = value.replace("dists/trixie/main/", "main/")
        if "Acquire-By-Hash: yes" not in value:
            value += "Acquire-By-Hash: yes\n"
        release.write_text(value)
        fingerprint = os.environ["SIGNING_FINGERPRINT"]
        inrelease = release_dir / "InRelease"
        sig = release_dir / "Release.gpg"
        run("gpg", "--batch", "--yes", "--local-user", fingerprint,
            "--clearsign", "-o", str(inrelease), str(release))
        run("gpg", "--batch", "--yes", "--local-user", fingerprint,
            "--detach-sign", "-o", str(sig), str(release))
        public = site / "mbligh-archive-keyring.gpg"
        with public.open("wb") as f:
            run("gpg", "--batch", "--export", fingerprint, stdout=f)

        # Publish indexes, then mutable Release metadata; InRelease is the commit point.
        for p in (index, gz, public, release, sig, inrelease):
            key = str(p.relative_to(site))
            put(p, key, cache="no-cache, must-revalidate")
        # Retire manifests only after InRelease (the publication commit point).
        retire_pending(markers)
        print("Indexed", added, "new package objects; total", len(entries))


if __name__ == "__main__":
    action = sys.argv[1]
    if action == "bootstrap":
        bootstrap()
    elif action == "stage":
        stage(sys.argv[2])
    elif action == "index":
        index(sys.argv[2] if len(sys.argv) > 2 else "")
    else:
        raise SystemExit("Usage: r2-publish {bootstrap|stage RUN_ID|index [RUN_ID]}")
