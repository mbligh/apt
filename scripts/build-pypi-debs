#!/usr/bin/env python3
"""Build reproducible Debian packages from pinned PyPI wheels."""
import argparse
import email
import hashlib
import importlib.metadata
import lzma
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import zipfile

NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*(?:==[A-Za-z0-9][A-Za-z0-9_.+!-]*)?$")


def run(*args, **kwargs):
    subprocess.run(args, check=True, **kwargs)


def manifest(path):
    seen = set()
    for number, line in enumerate(Path(path).read_text().splitlines(), 1):
        item = line.split('#', 1)[0].strip()
        if not item:
            continue
        if not NAME.fullmatch(item):
            raise ValueError(f'{path}:{number}: unsupported requirement: {item!r}')
        canonical = re.sub(r'[-_.]+', '-', item.split('==')[0]).lower()
        if canonical in seen:
            raise ValueError(f'{path}:{number}: duplicate package: {canonical}')
        seen.add(canonical)
        yield item, canonical


def metadata(wheel):
    with zipfile.ZipFile(wheel) as archive:
        names = [n for n in archive.namelist() if n.endswith('.dist-info/WHEEL')]
        if len(names) != 1:
            raise ValueError(f'Invalid wheel metadata: {wheel}')
        headers = email.message_from_bytes(archive.read(names[0]))
        if not headers.get_all('Tag'):
            raise ValueError(f'Wheel has no compatibility tags: {wheel}')
        tags = headers.get_all('Tag')
        if not all(tag.endswith('-none-any') or ('manylinux' in tag and 'x86_64' in tag) for tag in tags):
            raise ValueError(f'Unsupported wheel platform: {wheel}')
        return any(not tag.endswith('-none-any') for tag in tags)


def load_revisions(path):
    result = {}
    for number, line in enumerate(Path(path).read_text().splitlines(), 1):
        value = line.split('#', 1)[0].split()
        if not value:
            continue
        if len(value) != 2 or not value[1].isdigit() or int(value[1]) < 1:
            raise ValueError(f'{path}:{number}: expected "name revision"')
        name = re.sub(r'[-_.]+', '-', value[0]).lower()
        if name in result:
            raise ValueError(f'{path}:{number}: duplicate revision for {name}')
        result[name] = int(value[1])
    return result


def locked_wheels(lock):
    if not lock.is_file():
        raise FileNotFoundError(f'Missing hash lock: {lock}')
    expected = {}
    pending = None
    for line in lock.read_text().splitlines():
        line = line.strip()
        if line.startswith('# wheel: '):
            if pending:
                raise ValueError(f'Unpaired wheel: {pending}')
            pending = line.removeprefix('# wheel: ')
            if Path(pending).name != pending or not pending.endswith('.whl'):
                raise ValueError(f'Invalid wheel name: {pending}')
        elif line and not line.startswith('#'):
            match = re.fullmatch(
                r'[A-Za-z0-9][A-Za-z0-9_.-]*==[A-Za-z0-9][A-Za-z0-9_.+!-]* --hash=sha256:([0-9a-f]{64})',
                line)
            if not match or not pending or pending in expected:
                raise ValueError(f'Invalid locked wheel: {line}')
            expected[pending] = match.group(1)
            pending = None
    if pending or not expected:
        raise ValueError(f'Incomplete lock: {lock}')
    return expected


def build(requirement, canonical, output, python, revision, lock, expose_imports=False):
    with tempfile.TemporaryDirectory(prefix='pypi-deb-') as temp:
        root = Path(temp)
        wheels = root / 'wheels'
        wheels.mkdir()
        # Require the exact locked wheel closure and hashes.
        expected = locked_wheels(lock)
        run(python, '-m', 'pip', 'download', '--disable-pip-version-check',
            '--require-hashes', '--only-binary=:all:',
            '--dest', str(wheels), '-r', str(lock))
        actual = {wheel.name for wheel in wheels.glob('*.whl')}
        if actual != set(expected):
            raise ValueError(f'Wheel closure differs from {lock}: {sorted(actual)}')
        for wheel in wheels.glob('*.whl'):
            if hashlib.sha256(wheel.read_bytes()).hexdigest() != expected[wheel.name]:
                raise ValueError(f'Unexpected wheel contents: {wheel.name}')
        native = any(metadata(wheel) for wheel in wheels.glob('*.whl'))
        architecture = 'amd64' if native else 'all'
        payload = root / 'payload'
        lib = payload / 'usr' / 'lib' / ('pypi-' + canonical)
        lib.mkdir(parents=True)
        run(python, '-m', 'pip', 'install', '--disable-pip-version-check',
            '--require-hashes', '--no-index', '--find-links', str(wheels),
            '--no-compile', '--target', str(lib), '-r', str(lock))
        # pip --target may leave build-machine shebangs in bin/; wrappers replace them.
        shutil.rmtree(lib / 'bin', ignore_errors=True)
        for cache in lib.rglob('__pycache__'):
            shutil.rmtree(cache)
        distributions = list(importlib.metadata.distributions(path=[str(lib)]))
        match = [d for d in distributions if re.sub(r'[-_.]+', '-', d.metadata['Name']).lower() == canonical]
        if len(match) != 1:
            raise ValueError(f'Cannot identify installed distribution {canonical}')
        version = match[0].version
        if requirement.lower() not in (f'{canonical}=={version}'.lower(),
                                       f'{match[0].metadata["Name"]}=={version}'.lower()):
            raise ValueError(f'Root version disagrees with manifest: {requirement}')
        if not re.fullmatch(r'[0-9A-Za-z.+:~\-]+', version):
            raise ValueError(f'Unsupported Debian version: {version}')
        # The private import path is injected by wrappers; no runtime pip calls.
        scripts = [ep for ep in match[0].entry_points if ep.group == 'console_scripts']
        if not scripts:
            print(f'WARNING: {canonical} has no console_scripts; packaging library only')
        bindir = payload / 'usr' / 'bin'
        bindir.mkdir(parents=True)
        for ep in scripts:
            if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.+-]*', ep.name):
                raise ValueError(f'Unsafe command name: {ep.name}')
            dest = bindir / ep.name
            # Resolve entry points from the private wheel installation.
            dest.write_text('#!/usr/bin/python3\n'
                'import sys, importlib.metadata\n'
                f'sys.path.insert(0, {str("/usr/lib/pypi-" + canonical)!r})\n'
                f'dists = importlib.metadata.distributions(path={["/usr/lib/pypi-" + canonical]!r})\n'
                f'eps = (e for d in dists if d.metadata["Name"].lower().replace("_", "-").replace(".", "-") == {canonical!r} for e in d.entry_points)\n'
                f'sys.exit(next(e for e in eps if e.group == "console_scripts" and e.name == {ep.name!r}).load()())\n')
            dest.chmod(0o755)
        # Library-only packages can opt in to normal system Python imports.
        # Keep this explicit: a .pth also exposes bundled dependencies globally.
        if expose_imports:
            pth = payload / 'usr' / 'lib' / 'python3' / 'dist-packages' / f'pypi-{canonical}.pth'
            pth.parent.mkdir(parents=True, exist_ok=True)
            pth.write_text(f'/usr/lib/pypi-{canonical}\n')
        control = payload / 'DEBIAN'
        control.mkdir()
        # Changing this packaging or its lock requires a Debian revision bump.
        (control / 'control').write_text(
            f'Package: pypi-{canonical}\nVersion: {version}-{revision}\nSection: python\n'
            f'Priority: optional\nArchitecture: {architecture}\nMaintainer: mbligh APT <apt@mbligh.org>\n'
            'Depends: python3 (>= 3.11), python3 (<< 3.14)\n'
            f'Description: Isolated PyPI distribution {canonical}\n'
            ' Automatically repackaged from hash-pinned PyPI wheels.\n')
        # Stable mtimes and sorted archive entries make repeat builds byte-identical.
        for entry in sorted(payload.rglob('*'), reverse=True):
            os.utime(entry, (946684800, 946684800), follow_symlinks=False)
        os.utime(payload, (946684800, 946684800))
        output.mkdir(parents=True, exist_ok=True)
        deb = output / f'pypi-{canonical}_{version}-{revision}_{architecture}.deb'
        # dpkg-deb otherwise puts the current build time in the outer ar headers.
        # Match the normalized payload timestamps for byte-identical reruns.
        env = os.environ.copy()
        env['SOURCE_DATE_EPOCH'] = '946684800'
        run('dpkg-deb', '--build', '--root-owner-group', str(payload), str(deb), env=env)
        run('dpkg-deb', '--info', str(deb))
        print(f'BUILT {deb}')


def debian_names(path):
    if not path:
        return set()
    with lzma.open(path, 'rt', encoding='utf-8') as stream:
        return {line[9:].strip() for line in stream if line.startswith('Package: ')}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--manifest', default='pypi-packages.txt')
    parser.add_argument('--output', default='dist')
    parser.add_argument('--locks', default='pypi-locks')
    parser.add_argument('--revisions', default='pypi-revisions.txt')
    parser.add_argument('--package', help='Build just this normalized PyPI distribution')
    parser.add_argument('--exposed', default='pypi-exposed.txt',
                        help='Manifest of packages exposed to system Python imports')
    parser.add_argument('--debian-packages', help='Debian trixie Packages.xz index for duplicate detection')
    args = parser.parse_args()
    existing = debian_names(args.debian_packages)
    revision_map = load_revisions(args.revisions)
    exposed = {canonical for _, canonical in manifest(args.exposed)} if Path(args.exposed).exists() else set()
    found = False
    for requirement, canonical in manifest(args.manifest):
        if args.package is not None and canonical != args.package:
            continue
        found = True
        debian_package = 'python3-' + canonical
        if debian_package in existing:
            print(f'SKIP {requirement}: Debian already provides {debian_package}')
            continue
        if canonical not in revision_map:
            raise ValueError(f'Missing Debian revision for {canonical}')
        build(requirement, canonical, Path(args.output), sys.executable,
              revision=revision_map[canonical],
              lock=Path(args.locks) / f'{canonical}.txt',
              expose_imports=canonical in exposed)
    if args.package is not None and not found:
        raise SystemExit(f'No matching distribution in manifest: {args.package}')


if __name__ == '__main__':
    main()
