#!/usr/bin/env python3
"""Write hash-pinned wheel locks for Debian 13 (Python 3.13, Linux amd64).

Run with the same Python and pip version as the Debian package builder.
Regenerating a lock is an explicit package upgrade and requires a Debian
revision bump when its contents change.
"""
import argparse
import email
import hashlib
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import zipfile


def canonical(name):
    return re.sub(r"[-_.]+", "-", name).lower()


def requirements(manifest):
    for line in Path(manifest).read_text().splitlines():
        item = line.split("#", 1)[0].strip()
        if item:
            yield item


def wheel_identity(wheel):
    with zipfile.ZipFile(wheel) as archive:
        metadata = [name for name in archive.namelist()
                    if name.endswith(".dist-info/METADATA")]
        if len(metadata) != 1:
            raise ValueError(f"Missing or ambiguous metadata in {wheel}")
        message = email.message_from_bytes(archive.read(metadata[0]))
        name, version = message.get("Name"), message.get("Version")
        if not name or not version:
            raise ValueError(f"Missing name/version in {wheel}")
        return canonical(name), version


def generate(requirement, output):
    if requirement.count("==") != 1:
        raise ValueError(f"Pin the top-level distribution: {requirement!r}")
    name, version = requirement.split("==", 1)
    root = canonical(name)
    with tempfile.TemporaryDirectory(prefix="pypi-lock-") as directory:
        wheels = Path(directory)
        subprocess.run([sys.executable, "-m", "pip", "download",
                        "--disable-pip-version-check", "--only-binary=:all:",
                        "--dest", str(wheels), requirement], check=True)
        entries = {}
        for wheel in sorted(wheels.glob("*.whl")):
            dist, resolved = wheel_identity(wheel)
            if dist in entries:
                raise ValueError(f"Multiple wheels for {dist}")
            digest = hashlib.sha256(wheel.read_bytes()).hexdigest()
            entries[dist] = (resolved, wheel.name, digest)
        if root not in entries or entries[root][0] != version:
            raise ValueError(f"Resolved wheel missing or wrong root: {requirement}")
        lines = [
            "# Generated by scripts/lock-pypi-wheels for Python 3.13 / Linux amd64.",
            "# Each entry pins the exact wheel, including native dependencies.",
            "# Update the Debian revision when changing this file.",
        ]
        for dist, (resolved, filename, digest) in sorted(entries.items()):
            lines.extend((f"# wheel: {filename}",
                          f"{dist}=={resolved} --hash=sha256:{digest}"))
        output.mkdir(parents=True, exist_ok=True)
        destination = output / f"{root}.txt"
        destination.write_text("\n".join(lines) + "\n")
        print(f"Locked {requirement} ({len(entries)} wheels) -> {destination}")
        print(f"=== BEGIN {destination} ===")
        print(destination.read_text(), end="")
        print(f"=== END {destination} ===")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--manifest", default="pypi-packages.txt")
    parser.add_argument("--requirement", action="append",
                        help="Explicit pinned root (repeatable); otherwise use manifest")
    parser.add_argument("--output", type=Path, default=Path("pypi-locks"))
    args = parser.parse_args()
    for requirement in args.requirement or list(requirements(args.manifest)):
        generate(requirement, args.output)


if __name__ == "__main__":
    main()
