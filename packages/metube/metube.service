[Unit]
Description=MeTube download web interface
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/nas/youtube

[Service]
Type=simple
User=1000
Group=1000
WorkingDirectory=/usr/lib/metube
EnvironmentFile=/etc/metube/metube.conf
Environment=PYTHONPATH=/usr/bin/yt-dlp
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/lib/metube/venv/bin/python /usr/lib/metube/app/main.py
Restart=on-failure
RestartSec=5
StateDirectory=metube
UMask=0022

[Install]
WantedBy=multi-user.target
