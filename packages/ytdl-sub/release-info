#!/usr/bin/env python3
"""Resolve the latest stable upstream release; emit safe, immutable asset metadata."""
import datetime
import json
import re
import sys


def resolve(release):
    version = release["tag_name"]
    if release["draft"] or release["prerelease"]:
        raise ValueError("Expected a stable upstream release")
    if not re.fullmatch(r"[0-9]{4}\.[0-9]{1,2}\.[0-9]{1,2}(?:\.post[0-9]+)?", version):
        raise ValueError(f"Unexpected release tag: {version!r}")
    assets = [a for a in release["assets"] if a["name"] == "ytdl-sub"]
    if len(assets) != 1:
        raise ValueError("Expected exactly one Linux amd64 ytdl-sub release asset")
    asset = assets[0]
    digest = asset.get("digest") or ""
    if not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
        raise ValueError("Upstream asset has no valid SHA-256 digest")
    asset_id = asset["id"]
    if type(asset_id) is not int or asset_id <= 0:
        raise ValueError("Invalid release asset ID")
    published = datetime.datetime.fromisoformat(release["published_at"].replace("Z", "+00:00"))
    epoch = int(published.timestamp())
    if published.tzinfo is None or epoch <= 0:
        raise ValueError("Invalid publication timestamp")
    return f"{version} {asset_id} {digest[7:]} {epoch}"


if __name__ == "__main__":
    print(resolve(json.load(sys.stdin)))
